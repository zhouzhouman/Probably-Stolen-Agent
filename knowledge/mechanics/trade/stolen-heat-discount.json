{
  "id": "stolen-heat-discount",
  "title": "赃物热度与折价",
  "category": "trade",
  "summary": "热度≤25 折 10%、>75 折 25%，卖出声望倍率 1.5 到 3.0。",
  "facts": [
    "初始热度按基础价值分档：≤17 不标记为赃物；18–49 → 25；50–84 → 50；85–139 → 75；≥140 → 100。",
    "买入折价按热度：≤25 → −10%；≤50 → −15%；≤75 → −20%；>75 → −25%。",
    "卖出交易声望倍率：≤25 → ×1.5；≤50 → ×2.0；≤75 → ×2.5；>75 → ×3.0。",
    "每次热度更新降温：无违禁标签 −18；低/中/高/高危依次 −16/−14/−12/−10；降到 0 移除赃物标记。",
    "静态证据未定位该更新函数的调用频率，不能写成固定「每天一次」。",
    "买入是折价不是加价，判断是否合算要用实际报价与买家需求核算。",
    "当前观测层无「赃物热度」字段，需扩展。"
  ],
  "actions": [
    "优先收 ≤17 基础价值的货（干脆不带赃物标记）",
    "高热度货按 −25% 折价谈，但按 ×3.0 声望算收益"
  ],
  "pitfalls": [
    "以为放一晚必降一档：降温频率未确认",
    "对基础价值套固定倍率估价，忽略实际报价"
  ],
  "effects": [
    "热度降到 0 后赃物标记移除"
  ],
  "guards": [
    "热度 >75 的货不要押上全部现金"
  ],
  "keywords": [
    "热度",
    "赃物标记",
    "折价特征",
    "交易声望"
  ],
